# Database URL:
# For local SQLite: sqlite:///./attendance.db
# For production PostgreSQL: postgresql://username:password@db-host:5432/biometric_db
DATABASE_URL=sqlite:///./attendance.db

# Webhook Debounce (minutes between consecutive punches to prevent accidental double-punch)
DEBOUNCE_MINUTES=5.0

# Optional server listening port
PORT=8000
